PORT=8889
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads
# In Vercel, add the Neon pooled connection string in Project Settings > Environment Variables.
# Locally, set this in the private .env file. Never put credentials in this example file.
DATABASE_URL=
# Required for direct-to-Blob uploads when DATABASE_URL is set.
BLOB_READ_WRITE_TOKEN=


# Required by the Vercel Gmail watch renewal cron when Gmail Pub/Sub is configured.
CRON_SECRET=
# Optional server-only key for indexed PIN lookup when there are many users.
PIN_LOOKUP_SECRET=
# Comma-separated exact frontend origins allowed to call the API from a browser.
FRONTEND_ORIGINS=https://www.natheelcoo.com
# Optional server-only ClickUp API token.
CLICKUP_API_TOKEN=
# Google OAuth web client credentials (keep secrets in this server-side .env only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8889/api/mails/auth/google/callback
# 32-byte base64 key used to encrypt Gmail refresh tokens at rest.
MAILS_TOKEN_ENCRYPTION_KEY=
# Preferred verified Gmail "Send mail as" address.
MAILS_SEND_AS_EMAIL=asma.g@natheelco.com
# Frontend URL used after Google authorization completes.
MAILS_APP_URL=http://localhost:5173/
# Optional Gmail push delivery; leave all fields blank to use history polling only.
MAILS_PUBSUB_TOPIC=
MAILS_PUBSUB_SUBSCRIPTION=
MAILS_PUBSUB_AUDIENCE=
MAILS_PUBSUB_SERVICE_ACCOUNT=
